{
  "name": "ask-my-tabs",
  "version": "0.1.0",
  "description": "Ask questions across your open tabs and get cited answers. Embeddings run in the browser; vectors live in your own Qdrant (local or Cloud); answers come from an on-device model or your own API key.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mihir Inamdar",
  "repository": {
    "type": "git",
    "url": "https://github.com/inamdarmihir/ask-my-tabs.git"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "eval": "node eval/run-eval.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.23.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.5",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.12.0",
    "@langchain/openai": "^1.6.0",
    "@mlc-ai/web-llm": "^0.2.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepagents": "^1.14.1",
    "langchain": "^1.5.14",
    "langsmith": "^0.9.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "stemmer": "^2.0.1",
    "tailwind-merge": "^3.7.0"
  }
}
