{
  "name": "ask-my-tabs",
  "version": "0.1.0",
  "description": "Ask questions across your open tabs and get cited answers. Embeddings run in the browser; vectors live in your own Qdrant (local or Cloud); answers come from an on-device model or your own API key.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mihir Inamdar",
  "repository": {
    "type": "git",
    "url": "https://github.com/inamdarmihir/ask-my-tabs.git"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "eval": "node eval/run-eval.js"
  },
  "devDependencies": {
    "esbuild": "^0.23.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.5",
    "@mlc-ai/web-llm": "^0.2.79"
  }
}
