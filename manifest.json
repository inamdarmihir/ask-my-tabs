{
  "manifest_version": 3,
  "name": "Ask My Tabs",
  "version": "0.2.0",
  "description": "Ask questions across your tabs, backed by a local Qdrant reading library. Embeddings and answer generation run on your machine; retrieval is stored in Docker-hosted Qdrant on 127.0.0.1 only.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ask My Tabs"
  },
  "background": {
    "service_worker": "dist/background.bundle.js",
    "type": "module"
  },
  "permissions": ["tabs", "scripting", "storage", "activeTab", "offscreen"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:6333/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
